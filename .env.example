# Môi trường LOCAL (máy của nhóm, môn NLP). Sao chép thành .env và điền giá trị thật.
# KHÔNG commit file .env lên GitHub.
APP_ENV=local

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=luat_gt
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=doi_mat_khau

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=doi_mat_khau

# OpenRouter → Keys: tạo key, đặt hạn mức chi tiêu (credit limit) cho key
OPENROUTER_API_KEY=
# Không bắt buộc: dự phòng cho sinh câu trả lời khi khóa OpenRouter hết hạn mức (chỉ mô hình openai/...)
OPENAI_API_KEY=
ADMIN_PASSWORD=doi_mat_khau_quan_tri
CORS_ORIGINS=http://localhost:5173

# Khóa ký phiên đăng nhập giao diện web: chuỗi ngẫu nhiên dài, vd. python -c "import secrets;print(secrets.token_urlsafe(48))"
# Tài khoản tạo bằng: python scripts/tao_tai_khoan.py them <tên> --ho-ten "Họ tên"
AUTH_SECRET=
